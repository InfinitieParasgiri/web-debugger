{
  "name": "next-ssr-debugger",
  "version": "1.0.0",
  "description": "Server-side network and SSR API debugger for Next.js (App Router & RSC)",
  "main": "./dist/client.js",
  "types": "./dist/client.d.ts",
  "bin": {
    "next-ssr-debugger": "./bin/cli.mjs"
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "exports": {
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.mjs",
      "require": "./dist/server.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.mjs",
      "require": "./dist/client.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepare": "tsup"
  },
  "keywords": [
    "nextjs",
    "ssr",
    "rsc",
    "debugger",
    "devtools",
    "network-inspector",
    "react-server-components"
  ],
  "license": "MIT",
  "peerDependencies": {
    "next": ">=13.4.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "next": "^14.2.0",
    "react": "^18.2.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  }
}
