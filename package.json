{
  "name": "next-web-debugger",
  "version": "0.1.0",
  "description": "Session-based floating network and console debugger for Next.js",
  "type": "module",
  "license": "MIT",
  "main": "./src/browser.js",
  "types": "./src/browser.d.ts",
  "files": ["src", "README.md", "LICENSE"],
  "exports": {
    ".": { "types": "./src/browser.d.ts", "default": "./src/browser.js" },
    "./react": { "types": "./src/react.d.ts", "default": "./src/react.js" },
    "./next": { "types": "./src/next.d.ts", "default": "./src/next.js" },
    "./server": { "types": "./src/server.d.ts", "default": "./src/server.js" }
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:browser": "playwright test",
    "check": "node --check src/browser.js && node --check src/core.js && node --check src/server.js && node --check src/react.js && node --check src/next.js",
    "prepack": "npm run check && npm test"
  },
  "engines": { "node": ">=20" },
  "peerDependencies": { "react": ">=18" },
  "peerDependenciesMeta": { "react": { "optional": true } },
  "devDependencies": { "@playwright/test": "^1.56.0", "axios": "^1.20.0" }
}
